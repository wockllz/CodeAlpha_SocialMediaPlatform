<%- include('partials/header') %>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h2>Join CodeAlpha Social</h2>
            <p>Create an account to post updates, like, comment, and follow friends</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/register" method="POST" class="auth-form">
            <div class="form-group">
                <label for="username"><i class="fa-solid fa-at"></i> Username</label>
                <input type="text" id="username" name="username" class="form-control" placeholder="e.g. dev_sam" required minlength="3">
            </div>

            <div class="form-group">
                <label for="email"><i class="fa-solid fa-envelope"></i> Email Address</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="sam@example.com" required>
            </div>

            <div class="form-group">
                <label for="password"><i class="fa-solid fa-key"></i> Password</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="At least 6 characters" required minlength="6">
            </div>

            <div class="form-group">
                <label for="bio"><i class="fa-solid fa-pen-nib"></i> Bio (Optional)</label>
                <textarea id="bio" name="bio" class="form-control" rows="2" placeholder="Tell the community about yourself..."></textarea>
            </div>

            <div class="form-group">
                <label for="avatar_url"><i class="fa-solid fa-image"></i> Avatar Image URL (Optional)</label>
                <input type="url" id="avatar_url" name="avatar_url" class="form-control" placeholder="https://images.unsplash.com/...">
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <span>Create Account</span>
                <i class="fa-solid fa-user-check"></i>
            </button>
        </form>

        <div class="auth-footer">
            <p>Already have an account? <a href="/login">Log In</a></p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
